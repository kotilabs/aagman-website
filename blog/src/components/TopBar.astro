---
export interface Props {
  activeNav?: 'posts' | 'authors' | 'docs';
}
const { activeNav = 'posts' } = Astro.props;
---

<div class="topbar">
  <label for="nav-toggle" class="nav-toggle-btn" aria-label="Open navigation">
    <svg class="ico-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    <svg class="ico-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6l12 12M18 6l-12 12"></path></svg>
  </label>
  <a class="brand" href="/">
    <span class="brand-mark"></span>
    <span class="brand-name">Āagman</span>
    <span class="brand-section">BLOG</span>
  </a>
  <nav class="topnav">
    <a href="/blog/" class={activeNav === 'posts' ? 'active' : ''}>All Posts</a>
    <a href="/blog/author/" class={activeNav === 'authors' ? 'active' : ''}>Authors</a>
    <a href="/docs/">Docs</a>
  </nav>
  <div class="topright">
    <div class="search">
      <svg class="icn" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="5"></circle><path d="M11 11l3 3"></path></svg>
      <input type="text" placeholder="Search articles…">
      <span class="kbd">⌘ K</span>
    </div>
    <a class="icon-btn" href="#" aria-label="Support">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"></circle><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.7-2.5 2-2.5 3.5"></path><circle cx="12" cy="17" r=".5" fill="currentColor"></circle></svg>
    </a>
    <a class="cta-dash" href="https://app.aagman.ai" target="_blank">Open App</a>
  </div>
</div>
