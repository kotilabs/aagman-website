---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const categories = ['Strategies & Systems', 'Execution & Order Types', 'Market Conditions & Setups', 'Psychology, Risk & Process'];
const uniqueCategories = categories.filter(cat => posts.some(p => p.data.category === cat));
---

<Base
  title="āagman Desk | āagman Blog"
  description="Notes on strategy, execution, and risk from the team building āagman — how to brief it better, where backtests lie to you, and what's shipping next."
  canonical="https://www.aagman.ai/blog/author/"
  ogType="profile"
  activeNav="authors"
  activeAuthor="aagman-desk"
>
  <div class="crumb">
    <a href="/blog/">Blog</a><span class="sep">/</span>
    <a href="/blog/author/">Authors</a><span class="sep">/</span>
    <span class="cur">āagman Desk</span>
  </div>

  <div class="profile-head">
    <span class="profile-avatar">Ā</span>
    <div class="profile-info">
      <h1 class="profile-name">āagman Desk</h1>
      <div class="profile-role">Editorial Desk</div>
      <p class="profile-bio">Notes on strategy, execution, and risk from the team building āagman — how to brief it better, where backtests lie to you, and what's shipping next.</p>
    </div>
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-num">{posts.length}</div>
        <div class="stat-label">Articles</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">{uniqueCategories.length}</div>
        <div class="stat-label">Topics</div>
      </div>
    </div>
  </div>

  <div class="topic-row">
    {uniqueCategories.map(cat => <span class="topic-chip">{cat}</span>)}
  </div>

  <div class="grid-head">
    <h2 class="h-section">Articles by the Desk</h2>
    <span class="result-count">{posts.length} articles</span>
  </div>

  <div class="grid">
    {posts.map(post => <PostCard post={post} />)}
  </div>

  <style is:global>
    .content { max-width: 980px; }
    .crumb { display: flex; align-items: center; gap: 8px; font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .14em; color: #56E8B8; text-transform: uppercase; margin-bottom: 26px; }
    .crumb .sep { color: #2e3d37; }
    .crumb a:hover { color: #E7EEEA; }
    .crumb .cur { color: #8a938e; }

    .profile-head { display: flex; align-items: flex-start; gap: 24px; padding-bottom: 32px; border-bottom: 1px solid rgba(255,255,255,0.07); margin-bottom: 36px; flex-wrap: wrap; }
    .profile-avatar { width: 84px; height: 84px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-family: 'Geist', sans-serif; font-size: 30px; font-weight: 700; flex-shrink: 0; background: rgba(86,232,184,0.16); color: #56E8B8; box-shadow: 0 8px 30px -8px rgba(86,232,184,0.35); }
    .profile-info { flex: 1; min-width: 220px; }
    .profile-name { font-family: 'Bricolage Grotesque', sans-serif; font-size: 32px; font-weight: 800; letter-spacing: -.02em; color: #E7EEEA; margin: 0 0 6px; }
    .profile-role { font-family: 'Geist Mono', monospace; font-size: 11.5px; color: #56E8B8; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 14px; }
    .profile-bio { font-size: 14.5px; color: #8a938e; line-height: 1.65; max-width: 560px; margin: 0; }

    .stats-row { display: flex; gap: 12px; flex-shrink: 0; }
    .stat-card { padding: 14px 20px; background: #0A0E0D; border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; text-align: center; min-width: 96px; }
    .stat-num { font-family: 'Bricolage Grotesque', sans-serif; font-size: 24px; font-weight: 800; color: #E7EEEA; }
    .stat-label { font-family: 'Geist Mono', monospace; font-size: 9.5px; color: #6b7570; letter-spacing: .08em; text-transform: uppercase; margin-top: 4px; }

    .topic-row { display: flex; flex-wrap: wrap; gap: 8px; margin: -14px 0 36px; }
    .topic-chip { font-family: 'Geist Mono', monospace; font-size: 10.5px; color: #56E8B8; background: rgba(86,232,184,0.08); border: 1px solid rgba(86,232,184,0.18); border-radius: 20px; padding: 5px 13px; letter-spacing: .02em; }

    @media (max-width: 640px) {
      .profile-head { flex-direction: column; }
      .stats-row { width: 100%; }
      .stat-card { flex: 1; min-width: 0; padding: 12px 10px; }
      .profile-name { font-size: 26px; }
    }
  </style>
</Base>
